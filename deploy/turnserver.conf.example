# Copy to a private configuration file, replace each value, and restrict access to its owner.
listening-port=3478
tls-listening-port=5349
realm=turn.example.com
use-auth-secret
static-auth-secret=REPLACE_WITH_SAME_SECRET_AS_TURN_SHARED_SECRET
cert=/etc/arguide/turn-cert.pem
pkey=/etc/arguide/turn-key.pem
min-port=49160
max-port=49200
no-cli
no-multicast-peers
