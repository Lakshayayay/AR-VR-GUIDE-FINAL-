# Copy to backend/.env and start with: uv run uvicorn app.main:app --env-file .env --port 8000

# Where the database, uploads and the generated secret key are kept.
# DATA_DIR=./data

# Leave unset for SQLite while developing. For hosting: postgresql+psycopg://user:pass@host/db
# (then also run: uv add psycopg[binary])
# DATABASE_URL=

# Required in production: a long random string. Generate one with: python -c "import secrets;print(secrets.token_hex(32))"
# SECRET_KEY=

# The web app's address. "*" (any) is only for local development.
# ALLOWED_ORIGINS=https://arguide.example.com

# "true" when the site is served over https.
# COOKIE_SECURE=true

# Servers that help two devices find each other for video. Add your own relay (coturn) for strict networks;
# on a closed network with both devices on the same network, [] is enough.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
