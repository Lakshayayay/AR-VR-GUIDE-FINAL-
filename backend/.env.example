# Copy to backend/.env and start with: uv run uvicorn app.main:app --env-file .env --port 8000

# ArGuide has no sign-in. Keep it on localhost or a trusted private network.

# Where the database and uploads are kept.
# DATA_DIR=./data

# Leave unset for SQLite while developing. For hosting: postgresql+psycopg://user:pass@host/db
# (then also run: uv add psycopg[binary])
# DATABASE_URL=

# The web app's address. Use the exact origin for a private-network install.
# ALLOWED_ORIGINS=https://arguide.example.internal

# Servers that help two devices find each other for video. Add your own relay (coturn) for strict networks;
# on a closed network with both devices on the same network, [] is enough.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# For coturn's shared-secret authentication, set both values. Credentials are issued per user and expire.
# TURN_URLS=["turn:turn.example.com:3478?transport=udp","turn:turn.example.com:3478?transport=tcp","turns:turn.example.com:5349?transport=tcp"]
# TURN_SHARED_SECRET=
# TURN_TTL_SECONDS=3600
